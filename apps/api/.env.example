API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required for task API routes (Phase 4H.1). Generate a long random secret locally;
# never commit the real value. Same value must be set for the Next.js server proxy
# (apps/web) as RAJOSA_API_TOKEN — server-only, never NEXT_PUBLIC_*.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAJOSA_API_TOKEN=

# Prefer absolute paths in real deployments so every process resolves the same roots.
WORKSPACE_ROOT=var/workspaces

# Durable task store (SQLite). Default under apps/api/var — outside workspaces.
# Single-process only; do not share one DB file across multiple API workers/instances.
# Do not set WEB_CONCURRENCY>1 (Uvicorn would start multiple workers without --reload).
TASK_DB_PATH=var/rajosa.sqlite3

# Required to use SumoPod. Default is mock.
# mock | sumopod
AGENT_ADAPTER=mock

SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4.1-mini
SUMOPOD_TIMEOUT_SECONDS=60
SUMOPOD_MAX_OUTPUT_CHARS=16000

# Isolated Python test execution (local only). Default off.
# off | local_container
# Do not enable until Docker daemon is up, a pinned image is loaded locally,
# and mandatory isolation controls have been verified. Never pulls images.
EXECUTION_RUNNER=off
EXECUTION_IMAGE=rajosa-exec-python:3.12-pytest
